<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- VISTA LIST (TABLA) -->
        <record id="facturacion_tree_view" model="ir.ui.view">
            <field name="name">Facturación List</field>
            <field name="model">facturacion.facturacion</field>
            <field name="arch" type="xml">
                <list string="Facturas">
                    <field name="numero_factura"/>
                    <field name="matricula_id"/>
                    <field name="cantidad"/>
                    <field name="estado"/>
                </list>
            </field>
        </record>

        <!-- VISTA FORM (FORMULARIO) -->
        <record id="facturacion_form_view" model="ir.ui.view">
            <field name="name">Facturación Form</field>
            <field name="model">facturacion.facturacion</field>
            <field name="arch" type="xml">
                <form string="Factura">
                    <sheet>
                        <group>
                            <group>
                                <field name="numero_factura"/>
                                <field name="matricula_id"/>
                            </group>
                            <group>
                                <field name="cantidad"/>
                                <field name="estado"/>
                            </group>
                        </group>
                        <separator string="Información de Alumno y Curso"/>
                        <group>
                            <field name="alumno_id" readonly="1"/>
                            <field name="curso_id" readonly="1"/>
                        </group>
                        <separator string="Detalles"/>
                        <group>
                            <field name="fecha_pago"/>
                            <field name="concepto" nolabel="1"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- VISTA SEARCH (BÚSQUEDA Y FILTROS) -->
        <record id="facturacion_search_view" model="ir.ui.view">
            <field name="name">Facturación Search</field>
            <field name="model">facturacion.facturacion</field>
            <field name="arch" type="xml">
                <search string="Buscar Facturas">
                    <field name="numero_factura"/>
                    <field name="matricula_id"/>
                </search>
            </field>
        </record>

        <!-- ACCIÓN (ir.actions.act_window) -->
        <record id="facturacion_action" model="ir.actions.act_window">
            <field name="name">Facturación</field>
            <field name="res_model">facturacion.facturacion</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="facturacion_tree_view"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Crea la primera factura
                </p>
            </field>
        </record>

    </data>
</odoo>
