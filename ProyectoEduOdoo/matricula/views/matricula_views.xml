<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- VISTA LIST (TABLA) -->
        <record id="matricula_tree_view" model="ir.ui.view">
            <field name="name">Matrícula List</field>
            <field name="model">matricula.matricula</field>
            <field name="arch" type="xml">
                <list string="Matrículas">
                    <field name="alumno_id"/>
                    <field name="curso_id"/>
                    <field name="estado"/>
                    <field name="fecha_inscripcion"/>
                </list>
            </field>
        </record>

        <!-- VISTA FORM (FORMULARIO) -->
        <record id="matricula_form_view" model="ir.ui.view">
            <field name="name">Matrícula Form</field>
            <field name="model">matricula.matricula</field>
            <field name="arch" type="xml">
                <form string="Matrícula">
                    <sheet>
                        <group>
                            <field name="alumno_id"/>
                            <field name="curso_id"/>
                            <field name="estado"/>
                            <field name="fecha_inscripcion"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- VISTA SEARCH (BÚSQUEDA Y FILTROS) -->
        <record id="matricula_search_view" model="ir.ui.view">
            <field name="name">Matrícula Search</field>
            <field name="model">matricula.matricula</field>
            <field name="arch" type="xml">
                <search string="Buscar Matrículas">
                    <field name="alumno_id"/>
                    <field name="curso_id"/>
                    <filter name="borrador" string="Borrador" domain="[('estado', '=', 'borrador')]"/>
                    <filter name="confirmada" string="Confirmada" domain="[('estado', '=', 'confirmada')]"/>
                    <filter name="pagada" string="Pagada" domain="[('estado', '=', 'pagada')]"/>
                </search>
            </field>
        </record>

        <!-- ACCIÓN (ir.actions.act_window) -->
        <record id="matricula_action" model="ir.actions.act_window">
            <field name="name">Matrículas</field>
            <field name="res_model">matricula.matricula</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="matricula_tree_view"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Registra la primera matrícula
                </p>
            </field>
        </record>

    </data>
</odoo>
